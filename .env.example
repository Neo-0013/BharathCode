# BharatCode API Configuration
# Get your API key from the BharatCode AI portal
BHARATCODE_API_KEY=your_bharatcode_api_key_here
BHARATCODE_API_BASE=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=deepseek-v4.1-flash

# ROS 2 Environment Settings
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=0
ROS_SECURITY_ENABLE=false
ROS_SECURITY_STRATEGY=Enforce

# App Configuration
PORT=8501
OFFLINE_MODE=false
